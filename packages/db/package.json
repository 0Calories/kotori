{
  "name": "@kotori/db",
  "version": "0.1.0",
  "private": true,
  "description": "Kotori's data model: the Drizzle tables, their enums and JSONB schemas, and the migrations drizzle-kit generates from them",
  "type": "module",
  "exports": {
    ".": {
      "@kotori/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "check": "drizzle-kit check"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:db"
    ],
    "targets": {
      "check": {
        "cache": true,
        "inputs": [
          "{projectRoot}/drizzle.config.ts",
          "{projectRoot}/src/**/*",
          "{projectRoot}/migrations/**/*",
          {
            "externalDependencies": [
              "drizzle-kit"
            ]
          }
        ]
      }
    }
  }
}
