{
  "name": "@kotori/services",
  "version": "0.1.0",
  "private": true,
  "description": "Kotori's use cases: the only code that reads and writes the database",
  "type": "module",
  "exports": {
    ".": {
      "@kotori/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@kotori/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@kotori/ai": "workspace:*",
    "@kotori/auth": "workspace:*",
    "@kotori/db": "workspace:*",
    "@kotori/domain": "workspace:*",
    "@kotori/email": "workspace:*",
    "@kotori/japanese": "workspace:*",
    "@kotori/jmdict": "workspace:*",
    "@kotori/nuance": "workspace:*",
    "@kotori/srs": "workspace:*",
    "@kotori/tts": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "jose": "catalog:"
  }
}
