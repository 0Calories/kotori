{
  "name": "kotori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nx run-many -t dev -p @kotori/api @kotori/worker --parallel=2 --outputStyle=stream",
    "dev:app": "nx run @kotori/app:dev",
    "seed": "pnpm --filter @kotori/worker run cli seed",
    "kotori": "pnpm --filter @kotori/worker run cli",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "assets": "tsx tools/render-assets.ts",
    "graph": "nx graph"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "effect": "4.0.3",
    "nx": "23.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
