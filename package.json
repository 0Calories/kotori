{
  "name": "kotori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev -p @kotori/api @kotori/worker --parallel=2 --outputStyle=stream",
    "dev:app": "nx run @kotori/app:dev",
    "seed": "pnpm --filter @kotori/worker run cli seed",
    "kotori": "pnpm --filter @kotori/worker run cli",
    "test": "nx run-many -t test && pnpm test:token-limit",
    "test:token-limit": "vitest run --config tools/vitest.config.ts",
    "prepare": "node tools/install-git-hooks.mjs",
    "typecheck": "nx run-many -t typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "nx run-many -t build",
    "sync": "nx sync",
    "assets": "tsx tools/render-assets.ts",
    "graph": "nx graph",
    "knip": "knip"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@neon/config": "catalog:",
    "@nx/js": "catalog:",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@~7.0.2",
    "effect": "catalog:",
    "knip": "catalog:",
    "nx": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
