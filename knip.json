{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["neon.ts", "tools/*.ts"]
    },
    "apps/app": {
      "entry": ["e2e/*.mjs", "src/**/*.web.{ts,tsx}"],
      "ignoreDependencies": ["playwright"]
    },
    "apps/backend": {
      "entry": ["src/entrypoints/*.{ts,tsx}"]
    }
  },
  "ignoreBinaries": ["flyctl"]
}
