{
  "name": "@kotori/app",
  "version": "0.1.0",
  "private": true,
  "description": "Kotori for iOS, Android and the web",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build": "expo export --platform web --source-maps && sh ../../tools/upload-web-sourcemaps.sh dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/gabarito": "^0.4.2",
    "@expo-google-fonts/hina-mincho": "^0.4.1",
    "@expo-google-fonts/murecho": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@kotori/contracts": "workspace:*",
    "@kotori/language": "workspace:*",
    "@sentry/react-native": "catalog:",
    "@tanstack/react-query": "^5.107.1",
    "effect": "catalog:",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "vercel": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:client",
      "type:app"
    ],
    "targets": {
      "typecheck": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          {
            "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
            "transitive": true
          }
        ],
        "syncGenerators": [
          "@nx/js:typescript-sync"
        ]
      },
      "build": {
        "cache": true,
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/tools/upload-web-sourcemaps.sh",
          {
            "env": "EXPO_PUBLIC_*"
          },
          {
            "env": "SENTRY_UPLOAD"
          }
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "deploy-preview": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/vercel.json",
          "{workspaceRoot}/tools/upload-web-sourcemaps.sh"
        ],
        "options": {
          "commands": [
            "vercel pull --yes --environment=preview",
            "vercel build",
            "vercel deploy --prebuilt"
          ],
          "parallel": false
        }
      },
      "deploy": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/vercel.json",
          "{workspaceRoot}/tools/upload-web-sourcemaps.sh"
        ],
        "options": {
          "commands": [
            "vercel pull --yes --environment=production",
            "vercel build --prod",
            "vercel deploy --prebuilt --prod"
          ],
          "parallel": false
        }
      }
    }
  }
}
