{
  "name": "@kotori/app",
  "version": "0.1.0",
  "private": true,
  "description": "Kotori for iOS, Android and the web",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build": "expo export --platform web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo-google-fonts/gabarito": "^0.4.2",
    "@expo-google-fonts/hina-mincho": "^0.4.1",
    "@expo-google-fonts/murecho": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@kotori/domain": "workspace:*",
    "@kotori/srs": "workspace:*",
    "@tanstack/react-query": "^5.104.2",
    "effect": "catalog:",
    "expo": "~57.0.28",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "vercel": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "dependsOn": [
          "^build"
        ]
      },
      "build": {
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "deploy": {
        "executor": "nx:run-commands",
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/vercel.json"
        ],
        "options": {
          "commands": [
            "vercel pull --yes --environment=production",
            "vercel build --prod",
            "vercel deploy --prebuilt --prod"
          ],
          "parallel": false
        }
      }
    }
  }
}
