# The Kotori API. Leave unset in development: the app finds the API on the same
# host as the dev server (port 4000).
# EXPO_PUBLIC_API_URL=https://api.example.com

# Set to "off" to use the sign-up and sign-in screens instead of starting signed
# in as the account `pnpm kotori dev-account` creates. Development only.
# EXPO_PUBLIC_DEV_SIGN_IN=off
