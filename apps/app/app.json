{
  "expo": {
    "name": "Kotori",
    "slug": "kotori",
    "scheme": "kotori",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.kotori",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "app.kotori",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF7F2"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Kotori",
      "shortName": "Kotori",
      "themeColor": "#FBF7F2",
      "backgroundColor": "#FBF7F2"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-audio",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F2",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#1C1A19" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
