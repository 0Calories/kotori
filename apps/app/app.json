{
  "expo": {
    "name": "Kotori",
    "slug": "kotori",
    "scheme": "kotori",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.kotori",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "app.kotori",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#94C1E2"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Kotori",
      "shortName": "Kotori",
      "themeColor": "#F7FAF7",
      "backgroundColor": "#F7FAF7"
    },
    "plugins": [
      ["expo-router", { "adaptiveColors": false }],
      "expo-secure-store",
      "expo-audio",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7FAF7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
