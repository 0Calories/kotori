{
  "expo": {
    "name": "Kotori",
    "slug": "kotori",
    "scheme": "kotori",
    "version": "0.1.0",
    "description": "Your companion for real-world Japanese and English — a usage-first dictionary, Ask Kotori, and a spaced-repetition notebook.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.kotori",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": ["en", "ja"],
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "app.kotori",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#94C1E2"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "en",
      "favicon": "./assets/favicon.png",
      "name": "Kotori",
      "shortName": "Kotori",
      "description": "Understand how Japanese and English are really used — with a usage-first dictionary, Ask Kotori for tricky expressions, and a notebook that helps words stick.",
      "themeColor": "#F6FAFC",
      "backgroundColor": "#F6FAFC"
    },
    "plugins": [
      ["expo-router", { "adaptiveColors": false }],
      "expo-secure-store",
      "expo-web-browser",
      "expo-audio",
      "expo-font",
      [
        "@sentry/react-native/expo",
        { "organization": "sparkwright", "project": "kotori-app", "url": "https://sentry.io/" }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6FAFC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
