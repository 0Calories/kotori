{
  "name": "@kotori/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Kotori's data pipeline: seeds JMDict and enriches entries with Jev, Claude and ElevenLabs",
  "bin": {
    "kotori": "./dist/main.js"
  },
  "type": "module",
  "scripts": {
    "cli": "tsx -C @kotori/source --disable-warning=ExperimentalWarning src/main.ts",
    "dev": "tsx watch -C @kotori/source --clear-screen=false --disable-warning=ExperimentalWarning src/main.ts work",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js work"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@kotori/ai": "workspace:*",
    "@kotori/auth": "workspace:*",
    "@kotori/db": "workspace:*",
    "@kotori/domain": "workspace:*",
    "@kotori/email": "workspace:*",
    "@kotori/jmdict": "workspace:*",
    "@kotori/nuance": "workspace:*",
    "@kotori/runtime": "workspace:*",
    "@kotori/tts": "workspace:*",
    "effect": "catalog:"
  }
}
