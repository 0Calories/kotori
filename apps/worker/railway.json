{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "NX_DAEMON=false pnpm nx run-many -t build -p @kotori/worker",
    "watchPatterns": [
      "/apps/worker/**",
      "/packages/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json",
      "/tsconfig.json",
      "/nx.json",
      "/.node-version"
    ]
  },
  "deploy": {
    "startCommand": "node --disable-warning=ExperimentalWarning apps/worker/dist/main.js work",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "overlapSeconds": 0,
    "drainingSeconds": 60
  }
}
