{
  "name": "@kotori/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Kotori's backend: the HTTP API, the enrichment worker and the kotori CLI, one deployable with three entry points, plus the admin console that runs the CLI locally",
  "bin": {
    "kotori": "./dist/entrypoints/cli.js"
  },
  "type": "module",
  "scripts": {
    "dev:http": "tsx watch --clear-screen=false -C @kotori/source src/entrypoints/http.ts",
    "dev:worker": "tsx watch --clear-screen=false -C @kotori/source src/entrypoints/worker.ts",
    "kotori": "sh -c 'if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then exec pnpm run --silent console; fi; exec pnpm run --silent cli \"$@\"' kotori",
    "cli": "tsx -C @kotori/source src/entrypoints/cli.ts",
    "console": "TSX_TSCONFIG_PATH=tsconfig.lib.json pnx --silent node@26.13.0 --experimental-ffi --disable-warning=ExperimentalWarning --import tsx -C @kotori/source src/entrypoints/console.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@kotori/ai": "workspace:*",
    "@kotori/contracts": "workspace:*",
    "@kotori/db": "workspace:*",
    "@kotori/language": "workspace:*",
    "@kotori/srs": "workspace:*",
    "@sentry/effect": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "jose": "catalog:"
  },
  "devDependencies": {
    "@effect/sql-pglite": "catalog:",
    "@opentui/core": "0.8.2",
    "@opentui/react": "0.8.2",
    "@types/react": "catalog:",
    "@typesafe-ai/sdk": "catalog:",
    "react": "catalog:"
  },
  "nx": {
    "tags": [
      "scope:backend",
      "type:app"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "pnpm run dev:http",
            "pnpm run dev:worker"
          ],
          "parallel": true,
          "cwd": "{projectRoot}"
        }
      },
      "deploy": {
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          "{workspaceRoot}/packages/db/migrations/**/*",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/Dockerfile",
          "{workspaceRoot}/.dockerignore",
          "{workspaceRoot}/fly.toml"
        ],
        "command": "flyctl deploy --remote-only --env SENTRY_RELEASE=$(git rev-parse HEAD)"
      }
    }
  }
}
