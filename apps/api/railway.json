{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "NX_DAEMON=false pnpm nx run-many -t build -p @kotori/api",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json",
      "/tsconfig.json",
      "/nx.json",
      "/.node-version"
    ]
  },
  "deploy": {
    "startCommand": "node --disable-warning=ExperimentalWarning apps/api/dist/main.js",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "drainingSeconds": 30
  }
}
