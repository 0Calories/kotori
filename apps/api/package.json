{
  "name": "@kotori/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kotori's HTTP API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch -C @kotori/source --clear-screen=false --disable-warning=ExperimentalWarning src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@kotori/ai": "workspace:*",
    "@kotori/auth": "workspace:*",
    "@kotori/db": "workspace:*",
    "@kotori/domain": "workspace:*",
    "@kotori/email": "workspace:*",
    "@kotori/japanese": "workspace:*",
    "@kotori/nuance": "workspace:*",
    "@kotori/runtime": "workspace:*",
    "@kotori/srs": "workspace:*",
    "@kotori/tts": "workspace:*",
    "effect": "catalog:"
  }
}
