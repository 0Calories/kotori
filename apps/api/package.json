{
  "name": "@kotori/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kotori's HTTP API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false -C @kotori/source src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@kotori/ai": "workspace:*",
    "@kotori/auth": "workspace:*",
    "@kotori/db": "workspace:*",
    "@kotori/domain": "workspace:*",
    "@kotori/email": "workspace:*",
    "@kotori/japanese": "workspace:*",
    "@kotori/nuance": "workspace:*",
    "@kotori/srs": "workspace:*",
    "@kotori/tts": "workspace:*",
    "effect": "catalog:"
  },
  "nx": {
    "targets": {
      "deploy": {
        "dependsOn": [
          "build",
          {
            "projects": [
              "@kotori/worker"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "production",
          {
            "dependentTasksOutputFiles": "**/*",
            "transitive": true
          },
          "{workspaceRoot}/packages/db/migrations/**/*",
          "{workspaceRoot}/Dockerfile",
          "{workspaceRoot}/.dockerignore",
          "{workspaceRoot}/fly.toml"
        ],
        "command": "flyctl deploy --remote-only"
      }
    }
  }
}
