# Copy to .env and fill in. The API and the worker both read this file.

# Claude: Naturalness check, "How do I say", and example sentences.
# (The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.)
ANTHROPIC_API_KEY=
# KOTORI_CLAUDE_MODEL=claude-opus-5-5

# TypeSafe Jev: nuance (formality, register, demographics) and similar words.
TYPESAFE_API_KEY=
# KOTORI_JEV_MODEL=jev-1.14.0

# ElevenLabs: pronunciation audio.
ELEVENLABS_API_KEY=
# KOTORI_ELEVENLABS_MODEL=eleven_v4
# Headword clips per entry, one per dictionary voice from the cast.
# KOTORI_HEADWORD_VOICES=3
# Characters of TTS allowed per 30 days, across all audio.
# KOTORI_AUDIO_MONTHLY_CHARS=50000

# Coach requests per learner per hour (cached answers don't count).
# KOTORI_COACH_HOURLY_LIMIT=60

# Auth: Neon's Managed Better Auth. Locally, `pnpm dev` runs a stand-in for it at this
# URL (apps/local-auth). To use a Neon branch instead, `neon checkout <branch>` writes the
# branch's URL into .env.local, which is loaded after .env. Set it explicitly in production.
NEON_AUTH_BASE_URL=http://localhost:4001/neondb/auth

# Origins of the hosted web app, comma-separated: the only browsers allowed to call the
# API with credentials. Local dev servers are allowed outside production anyway.
# KOTORI_WEB_ORIGINS=https://app.kotori.app

# Resend, for verification, password-reset and approval emails.
# Without it, emails are logged to the API console instead.
RESEND_API_KEY=
# KOTORI_EMAIL_FROM=Kotori <hello@mail.kotori.app>

# Postgres, shared by the API, the worker and Better Auth. Locally, the one in compose.yaml.
# For Neon use the direct (unpooled) connection string with sslmode=verify-full:
# both drivers then verify Neon's certificate against the system CA store.
DATABASE_URL=postgres://kotori:kotori@localhost:5432/kotori

# API server. Falls back to PORT (set by the host, see fly.toml), then 4000.
# KOTORI_PORT=4000
