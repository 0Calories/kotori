# Copy to .env and fill in. The API and the worker both read this file.

# Postgres. `docker compose up -d` starts one locally with these credentials;
# on Railway, reference the Postgres plugin: ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://kotori:kotori@localhost:5432/kotori

# Claude: Naturalness check, "How do I say", and example sentences.
# (The SDK also accepts ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.)
ANTHROPIC_API_KEY=
# KOTORI_CLAUDE_MODEL=claude-opus-5-5

# TypeSafe Jev: nuance (formality, register, demographics) and similar words.
TYPESAFE_API_KEY=
# KOTORI_JEV_MODEL=jev-1.13.0

# ElevenLabs: pronunciation audio.
ELEVENLABS_API_KEY=
# KOTORI_ELEVENLABS_MODEL=eleven_v4
# KOTORI_VOICE_JA=4lOQ7A2l7HPuG7UIHiKA
# KOTORI_VOICE_EN=EXAVITQu4vr4xnSDxMaL
# Characters of TTS allowed per 30 days, across all audio.
# KOTORI_AUDIO_MONTHLY_CHARS=50000
# Languages voiced for example sentences: "ja" or "ja,en".
# KOTORI_AUDIO_LANGUAGES=ja

# Coach requests per learner per hour (cached answers don't count).
# KOTORI_COACH_HOURLY_LIMIT=60

# Auth (Better Auth). Generate a secret with `openssl rand -base64 32`.
# Required when NODE_ENV=production (the API refuses to start without it);
# otherwise a known development secret is used.
BETTER_AUTH_SECRET=
# Public origin of the API, used in emailed links and cookie settings.
# Required when NODE_ENV=production; defaults to http://localhost:<KOTORI_PORT>.
# BETTER_AUTH_URL=http://localhost:4000
# Origin of the deployed web app, allowed for cookies/CORS.
# KOTORI_WEB_ORIGIN=

# Resend, for verification, password-reset and approval emails.
# Without it, emails are logged to the API console instead.
RESEND_API_KEY=
# KOTORI_EMAIL_FROM=Kotori <hello@mail.kotori.app>

# API server
# KOTORI_PORT=4000
# Set by Railway. Production requires the auth settings above and logs JSON lines.
# NODE_ENV=production
